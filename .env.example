# PostgreSQL URLs
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jobtrack_ai
DB_DRIZZLE_URL=postgres://postgres:postgres@localhost:5432/jobtrack_ai

# Auth/API
JWT_SECRET=replace-this-with-a-random-32-plus-character-secret
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Optional AI provider (OpenAI-compatible /v1/chat/completions endpoint)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Required to enable the scheduled reminder endpoint in production
CRON_SECRET=replace-with-a-long-random-secret

# SMTP (required in production for password resets and reminder emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=JobTrack AI <no-reply@example.com>

# OAuth providers
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
